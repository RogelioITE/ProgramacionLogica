# 1. ¿x es un estudiante registrado?-----------------------------------------------------------------------
def EsEstudiante(x):
    for estudiante, datos in universo["estudiantes"].items(): # .items() nos da tanto el nombre (estudiante) como sus datos guardados
        if estudiante == x:
            return True   #Si coincide el nombre, confirma que es estudiante
    return False          #Si recorrió todos y no estuvo, regresa falso

# 2. ¿El maestro x imparte la materia y?---------------------------------------------------------------------
def Ensena(x, y):
    for docente, datos in universo["docentes"].items():
        if docente == x:
            if y in datos["Imparte"]: #Revisa si la materia 'y' está dentro de la lista "Imparte" del profesor
                return True
    return False

# 3. ¿El alumno x cursa la materia y?-------------------------------------------------------------------
def Inscrito(x, y):
    for estudiante, datos in universo["estudiantes"].items():
        if estudiante == x:
            if y in datos["Inscrito"]: #Checa si la materia 'y' figura en su lista de inscritas
                return True
    return False

# 4. ¿El alumno x participa en el club y?--------------------------------------------------------------
def PerteneceAClub(x, y):
    for estudiante, datos in universo["estudiantes"].items():
        if estudiante == x:
            if datos["Club"] == y: #Compara directamente el club guardado contra el que estamos buscando
                return True
    return False

# 5. ¿El alumno x acreditó/aprobó la materia y?-------------------------------------------------------
def Aprobado(x, y):
    for estudiante, datos in universo["estudiantes"].items():
        if estudiante == x:
            if y in datos["Aprobado"]: #Revisa si la materia está dentro de su lista de aprobadas
                return True
    return False

# 6. ¿La asignatura x requiere horas de laboratorio?--------------------------------------------------
def RequierePractica(x):
    for asignatura, datos in universo["asignaturas"].items():
        if asignatura == x:
            if datos["Requiere_Practica"]: #Si el valor de Requiere_Practica es True, entra al if
                return True
    return False

# 7. ¿La asignatura x se imparte en el laboratorio y?-------------------------------------------------
def OcupaLab(x, y):
    for asignatura, datos in universo["asignaturas"].items():
        if asignatura == x:
            if datos["Laboratorio"] == y: #Compara si el laboratorio registrado coincide exactamente con 'y'
                return True
    return False

